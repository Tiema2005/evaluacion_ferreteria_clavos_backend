{
  "info": {
    "name": "Ferretería Los Maestros · Avance DSY1104",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080/api/v1"
    },
    {
      "key": "correo",
      "value": "avance18@example.com"
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Registrar usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('El servidor asignó un rol y omitió el hash', () => { const usuario = pm.response.json(); pm.expect(usuario.rol).to.be.a('string').and.not.empty; pm.expect(usuario).not.to.have.property('hash'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Cuenta\",\n  \"apellido\": \"Prueba\",\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Iniciar sesión",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JWT con vigencia de una hora', () => { const sesion = pm.response.json(); pm.expect(sesion.token.split('.')).to.have.lengthOf(3); pm.expect(sesion.expiraEnSegundos).to.equal(3600); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Rechazar credenciales incorrectas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401 con mensaje genérico', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().mensaje).to.equal('Credenciales incorrectas.'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}-incorrecta\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
